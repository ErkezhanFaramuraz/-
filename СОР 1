import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int[] arr = {1, 2, 3, 4, 5, 6};

        System.out.print("X санын енгізіңіз: ");
        int X = sc.nextInt();

        boolean tabyldy = false;

        for (int i = 0; i < arr.length; i++) {
            for (int j = i + 1; j < arr.length; j++) {
                if (arr[i] + arr[j] == X) {
                    System.out.println(arr[i] + " + " + arr[j] + " = " + X);
                    tabyldy = true;
                }
            }
        }

        if (!tabyldy) {
            System.out.println("Мұндай қосынды табылмады.");
        }
    }
}
